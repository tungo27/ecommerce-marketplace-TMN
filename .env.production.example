# ==========================================
# E-COMMERCE MARKETPLACE PRODUCTION ENV CONFIG
# ==========================================

# 1. Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password_123!
POSTGRES_DB=ecommerce_TMN_db

# 2. JWT Authentication (Khóa bí mật tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=ecommerce_secret_jwt_key_super_secure_random_hash_2026_xyz
JWT_EXPIRATION=24h

# 3. Domain & URLs Cấu Hình (Thay thế bằng domain thực tế hoặc IP VPS)
# Ví dụ:
# FRONTEND_URL=https://shop.yourdomain.com
# BACKOFFICE_URL=https://admin.yourdomain.com
# ALLOWED_ORIGINS=https://shop.yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Public API URL dành cho Client-side Browser gọi về Backend
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/api

# 4. Cloudinary (Lưu trữ upload hình ảnh)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# 6. Sentry APM & Error Tracking (Tùy chọn)
SENTRY_DSN=
