// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum ProductStatus {
  Draft
  Pending
  Published
  Hidden
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String?
  googleId     String?          @unique
  role         Role
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  products     Product[]
  orders       Order[]
  reviews      Review[]
  waitlists    Waitlist[]
  AuditLog     AuditLog[]
  disputes     Dispute[]        @relation("CustomerDisputes")
  disputeMsgs  DisputeMessage[]
}

model Product {
  id            String        @id @default(uuid())
  name          String        @db.VarChar(100)
  description   String        @db.VarChar(2000)
  price         Decimal       @db.Decimal(10, 2)
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  stock         Int           @default(0)
  images        String[]
  status        ProductStatus @default(Pending)
  averageRating Float         @default(0.0)
  version       Int           @default(1) // Support Optimistic Locking to prevent Race Conditions
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  reviews       Review[]
  waitlists     Waitlist[]
  AuditLog      AuditLog[]

  // Note: A GIN index named "product_fts_gin_idx" is manually managed via raw SQL migration
  // to support PostgreSQL Full-Text Search on name and description.
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  customer        User          @relation(fields: [userId], references: [id])
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingAddress String
  phoneNumber     String
  paymentMethod   String // "COD" or "BANK_TRANSFER"
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  transactions    Transaction[]
  reviews         Review[]
  Dispute         Dispute?

  @@index([userId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
}

model Transaction {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  accountId   String
  amount      Decimal  @db.Decimal(10, 2)
  type        String // "DEBIT" or "CREDIT"
  description String
  status      String   @default("PENDING") // "PENDING" | "SETTLED"
  createdAt   DateTime @default(now())
}

model Review {
  id        String       @id @default(uuid())
  rating    Int          @db.SmallInt
  comment   String?      @db.VarChar(200)
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  createdAt DateTime     @default(now())
  isHidden  Boolean      @default(false)
  reply     ReviewReply?

  @@unique([userId, productId, orderId])
  @@index([productId])
}

model Waitlist {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  action    String
  createdAt DateTime @default(now())
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id])
  comment   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model StorefrontConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED_REFUND
  RESOLVED_REJECT
}

model Dispute {
  id          String           @id @default(uuid())
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id])
  customerId  String
  customer    User             @relation("CustomerDisputes", fields: [customerId], references: [id])
  reason      String
  description String
  status      DisputeStatus    @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    DisputeMessage[]
}

model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  message   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
}
